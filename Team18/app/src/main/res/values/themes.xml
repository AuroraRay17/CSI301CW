<resources>
    <style name="Base.Theme.Team18" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/surface_tint</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/ui_secondary</item>
        <item name="colorSecondaryContainer">@color/soft_button</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted_text</item>
        <item name="colorOutline">@color/ui_outline</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.Team18.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Team18.Button.Outlined</item>
    </style>

    <style name="Theme.Team18" parent="Base.Theme.Team18" />

    <style name="ShapeAppearanceOverlay.Team18.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.Team18.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Team18.Button</item>
        <item name="fontFamily">@font/zcool_kuaile</item>
        <item name="android:fontFamily">@font/zcool_kuaile</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Team18.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Team18.Button</item>
        <item name="fontFamily">@font/zcool_kuaile</item>
        <item name="android:fontFamily">@font/zcool_kuaile</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Team18.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Team18.Button</item>
        <item name="fontFamily">@font/zcool_kuaile</item>
        <item name="android:fontFamily">@font/zcool_kuaile</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Team18.Button.Scene" parent="Widget.Team18.Button">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@color/ui_accent</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.Team18.Button.Dock" parent="Widget.Team18.Button.Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">4dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ui_accent</item>
    </style>
</resources>
