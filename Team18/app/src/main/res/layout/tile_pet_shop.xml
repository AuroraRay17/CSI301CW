<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:background="@drawable/bg_shop_tile"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center" android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="35dp">
        <ImageView android:id="@+id/shopTileIcon"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="center" android:importantForAccessibility="no" />
        <TextView android:id="@+id/shopTileValue"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="@color/shop_mint_ink"
            android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/shopTileName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="center"
        android:textColor="@color/ink" android:textSize="14sp" />
</LinearLayout>
