<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/petGrowthTotal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ui_accent" android:textSize="18sp"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/pet_items"
        android:textColor="@color/ui_accent" android:textSize="15sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/petGrowthInteractions"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/ink"
        android:textSize="15sp" />
</LinearLayout>
