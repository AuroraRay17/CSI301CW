<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/shop_equipped" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/shop_equipped_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/shop_mint" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/timer_rest_track" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/shop_inactive" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_tint" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
